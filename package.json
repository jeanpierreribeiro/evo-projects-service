{
  "name": "evo-projects-service",
  "version": "1.0.0",
  "description": "Headless projects, multi-workspace, gantt and task validation service for jprOS (Kaneo Engine)",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:db": "vitest run test/db",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev"
  },
  "keywords": [
    "projects",
    "kaneo",
    "gantt",
    "jpros",
    "kanban",
    "workspace"
  ],
  "author": "jprOS",
  "license": "MIT",
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^10.1.6",
    "@fastify/sensible": "^6.0.3",
    "@prisma/client": "^6.4.1",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "ioredis": "^6.0.0",
    "jose": "^6.2.13",
    "nanoid": "^5.1.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  }
}
